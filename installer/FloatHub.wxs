<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="FloatHub" Manufacturer="FloatHub" Version="1.0.2" Language="2052" Codepage="936"
           Scope="perUser" UpgradeCode="{09B53545-D0C4-43CB-B3FB-22D74B9E353B}">
    <SummaryInformation Description="FloatHub Windows x64" Manufacturer="FloatHub"/>
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 FloatHub。"/>
    <MediaTemplate EmbedCab="yes" CompressionLevel="none"/>
    <Icon Id="AppIcon" SourceFile="$(var.Icon)"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon"/>
    <Property Id="INSTALLDIR" Secure="yes">
      <RegistrySearch Id="SavedInstallDirectory" Root="HKCU" Key="Software\FloatHub\Installer" Name="InstallDirectory" Type="raw" Bitness="always64"/>
    </Property>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs"><Directory Id="INSTALLDIR" Name="FloatHub">
        <Component Id="DesktopApplication" Guid="{21D7ADB7-81D7-4B1E-B632-42BEFA351F08}">
          <File Id="FloatHubExe" Source="$(var.Exe)"/>
          <RegistryValue Root="HKCU" Key="Software\FloatHub\Installer" Name="InstallDirectory" Type="string" Value="[INSTALLDIR]" KeyPath="yes"/>
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FloatHub" Target="[#FloatHubExe]" WorkingDirectory="INSTALLDIR" Icon="AppIcon"/>
          <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLDIR" On="uninstall"/>
          <RemoveFile Id="RemoveStartupLink" Name="FloatHub.lnk" Directory="StartupFolder" On="uninstall"/>
        </Component>
      </Directory></Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"/><StandardDirectory Id="StartupFolder"/>
    <Feature Id="FloatHub" Title="FloatHub" Level="1"><ComponentRef Id="DesktopApplication"/></Feature>
  </Package>
</Wix>
