<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Ink" Color="#15292D"/>
  <SolidColorBrush x:Key="Muted" Color="#52696A"/>
  <SolidColorBrush x:Key="Teal" Color="#08786B"/>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/></Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="#193E3C"/><Setter Property="Background" Value="#E4EFEB"/>
    <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,3,6,3"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Plate" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value=".80"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value=".42"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="#ADBFBC"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="7,3"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
</ResourceDictionary>
