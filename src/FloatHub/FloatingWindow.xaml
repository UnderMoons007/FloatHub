<Window x:Class="FloatHub.FloatingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="FloatHub 悬浮组件" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowActivated="False" ShowInTaskbar="False" Width="230" Height="96" WindowStartupLocation="Manual">
  <Grid ClipToBounds="True">
    <Canvas ClipToBounds="True">
    <Border x:Name="Body" Background="#142E31" CornerRadius="15" Padding="12,8,12,11" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Border.RenderTransform><TranslateTransform x:Name="Slide"/></Border.RenderTransform>
      <StackPanel>
        <DockPanel LastChildFill="False" Margin="1,0,0,5" MinWidth="167">
          <Button DockPanel.Dock="Right" x:Name="Options" Content="⚙" Foreground="#C6E8E0" FontSize="16" Background="#26474A" Margin="8,0,0,0" Padding="6,1" ToolTip="打开设置"/>
          <Border Background="#79D9B8" CornerRadius="3" Width="7" Height="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
          <TextBlock Text="FloatHub" Foreground="#F4FBF8" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer x:Name="Viewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="Modules"/>
        </ScrollViewer>
      </StackPanel>
    </Border>
    </Canvas>
    <Border x:Name="Grip" Background="#143D3C" CornerRadius="7" Visibility="Collapsed" Cursor="SizeAll" ToolTip="悬停展开 · 拖离边缘固定">
      <Border x:Name="GripLine" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#84E2BF" CornerRadius="2"/>
    </Border>
  </Grid>
</Window>
